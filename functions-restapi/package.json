{
  "name": "mvta-onboard-restapi",
  "version": "1.0.0",
  "description": "REST API for MVTA OnBoard - architecture doc Section 9",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "watch": "tsc -w",
    "clean": "rimraf dist dist-test",
    "prestart": "npm run build",
    "start": "func start",
    "pretest": "npm run build:test",
    "test": "node --test dist-test/src/lib/*.test.js dist-test/src/functions/*.test.js",
    "test:decision-matrix-contract": "npm run build:test && node --test dist-test/src/functions/decisionMatrixDrafts.db.contract.test.js dist-test/src/lib/migration101.db.contract.test.js dist-test/src/functions/onDemandRisks.db.contract.test.js"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.13.1",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.33.0",
    "adm-zip": "^0.6.0",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
